<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.NotebookController">
   <padding>
      <Insets top="10.0" />
   </padding>
   <children>
      <TextField fx:id="titleField" promptText="Title" />
      <TextArea fx:id="contentArea" promptText="Write your note…" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER" prefHeight="37.0" prefWidth="600.0">
         <children>
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAdd" text="Add" />
         </children>
      </HBox>
      <Label text="Saved notes:" />
      <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <ListView fx:id="notesList" prefHeight="200.0" prefWidth="200.0" />
            <TextField fx:id="noteContent" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDelete" text="Delete" />
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#handleEdit" text="Edit" />
         </children>
      </HBox>
   </children>
</VBox>
